{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baryonem.pe/contract/report_draft.schema.json",
  "title": "report_draft.json: lo que produce Folio",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "executive_summary", "top_gaps", "plan", "model"],
  "$defs": {
    "cited": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "cites"],
      "properties": {
        "text": {"type": "string", "minLength": 1, "maxLength": 400},
        "cites": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^F-[A-Z]{3}-[0-9]{3}$"}}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string", "minLength": 1},
    "executive_summary": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"$ref": "#/$defs/cited"}},
    "top_gaps": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "why_it_matters", "norma_refs", "cites"],
        "properties": {
          "finding_id": {"type": "string", "pattern": "^F-[A-Z]{3}-[0-9]{3}$"},
          "why_it_matters": {"type": "string", "maxLength": 400},
          "norma_refs": {"type": "array", "items": {"type": "string"}},
          "cites": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^F-[A-Z]{3}-[0-9]{3}$"}}
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["d30", "d60", "d90"],
      "properties": {
        "d30": {"type": "array", "items": {"$ref": "#/$defs/cited"}},
        "d60": {"type": "array", "items": {"$ref": "#/$defs/cited"}},
        "d90": {"type": "array", "items": {"$ref": "#/$defs/cited"}}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "prompt_version"],
      "properties": {
        "provider": {"type": "string"},
        "name": {"type": "string"},
        "prompt_version": {"type": "string"},
        "fallback": {"type": "boolean"}
      }
    }
  }
}
