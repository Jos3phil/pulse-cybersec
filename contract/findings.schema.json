{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baryonem.pe/contract/findings.schema.json",
  "title": "findings.json: lo que producen los agentes verificadores",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "clinic", "checks", "findings", "score", "signature"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string", "minLength": 1},
    "clinic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "his"],
      "properties": {
        "alias": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "his": {"enum": ["openemr"]}
      }
    },
    "agent_trace_ref": {"type": "string"},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "status", "mode"],
        "properties": {
          "check": {"enum": ["vigia", "escriba", "archivista"]},
          "status": {"enum": ["completed", "failed", "skipped"]},
          "mode": {"enum": ["agent", "script"]},
          "duration_s": {"type": "number", "minimum": 0},
          "error_code": {"type": "string"}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "control_id", "check", "severity", "evidence_level", "title", "facts", "evidence_calls"],
        "properties": {
          "finding_id": {"type": "string", "pattern": "^F-[A-Z]{3}-[0-9]{3}$"},
          "control_id": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{2}$"},
          "check": {"enum": ["vigia", "escriba", "archivista"]},
          "severity": {"enum": ["critica", "alta", "media", "baja"]},
          "evidence_level": {"enum": ["declarado", "documentado", "verificado"]},
          "title": {"type": "string", "maxLength": 120},
          "facts": {
            "type": "object",
            "description": "Solo números, booleanos, fechas ISO y códigos. Nunca texto libre de la clínica.",
            "additionalProperties": {
              "anyOf": [
                {"type": "number"},
                {"type": "boolean"},
                {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9:.]+Z?)?$"},
                {"type": "string", "pattern": "^[A-Z0-9_]{1,40}$"}
              ]
            }
          },
          "subjects": {
            "type": "array",
            "items": {"type": "string", "pattern": "^u_[0-9a-f]{6,16}$"}
          },
          "evidence_calls": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^call_[0-9]{3,}$"}
          }
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified_ratio"],
      "properties": {
        "verified_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "by_domain": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}}
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "value"],
      "properties": {
        "alg": {"const": "HMAC-SHA256"},
        "value": {"type": "string"}
      }
    }
  }
}
